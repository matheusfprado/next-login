datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  password  String?
  phone     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 
  portfolios Portfolio[]
  priceAlerts PriceAlert[]
  investmentGoals InvestmentGoal[]
  preferences UserPreference?
}

model Portfolio {
  id        String   @id @default(cuid())
  userId    String
  coinId    String   
  coinName  String   
  amount    Float   
  buyPrice  Float    
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PriceAlert {
  id             String          @id @default(cuid())
  userId         String
  coinId         String
  coinName       String
  targetPrice    Float
  direction      AlertDirection  @default(ABOVE)
  deliveryMethod AlertDelivery   @default(EMAIL)
  status         AlertStatus     @default(ACTIVE)
  triggeredAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model InvestmentGoal {
  id            String   @id @default(cuid())
  userId        String
  title         String
  description   String?
  targetAmount  Float
  currentAmount Float   @default(0)
  deadline      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  emailAlerts       Boolean  @default(true)
  smsAlerts         Boolean  @default(false)
  weeklySummary     Boolean  @default(true)
  language          String   @default("Português (Brasil)")
  currency          String   @default("Real (BRL)")
  dashboardDensity  String   @default("Confortável")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CryptoPriceHistory {
  id        String   @id @default(cuid())
  coinId    String
  coinName  String
  symbol    String
  priceUsd  Float
  marketCap Float?
  volume24h Float?
  change24h Float?
  createdAt DateTime @default(now())

  @@index([coinId, createdAt])
  @@index([createdAt])
}

enum AlertDirection {
  ABOVE
  BELOW
}

enum AlertDelivery {
  EMAIL
  SMS
}

enum AlertStatus {
  ACTIVE
  TRIGGERED
  DISABLED
}
